# Auto AI Technologies — standalone frontend
#
# This app talks to the SAME Lovable Cloud-managed Supabase backend as the
# live Lovable app (autoaibiz-xyz). It does NOT provision its own backend.
#
# Copy to `.env` for local dev and set the same values in Vercel.
# Never put a service-role key in this file — it would ship to the browser.

VITE_APP_NAME="Auto AI Technologies"

# Supabase (Lovable Cloud-managed, project ref: kjjgepsbjgnxqisojgta)
VITE_SUPABASE_URL="https://kjjgepsbjgnxqisojgta.supabase.co"

# The anon / publishable key (role must be "anon", never "service_role").
# Get it from the Lovable project's .env or Lovable project settings.
VITE_SUPABASE_PUBLISHABLE_KEY=""
